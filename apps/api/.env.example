# Copy to .env and fill in. Loaded automatically by `pnpm dev` / `pnpm start`.
OPENAI_API_KEY=
# TMDB "API Read Access Token" (v4, the long one), not the short v3 API key.
TMDB_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=none
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
